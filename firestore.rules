/**
 * @file Firestore Security Rules
 * @core_philosophy This ruleset enforces a strict user-ownership model for all data. Each user can only access their own data, and no data is publicly accessible.
 * @data_structure All data is nested under /users/{userId}, ensuring clear ownership. User profiles, avatar settings, and conversations are all stored as subcollections under the user's document.
 * @key_security_decisions
 *   - User listing is disallowed to protect user privacy.
 *   - Default security posture is strict; any access not explicitly allowed is denied.
 *   - Relies solely on `request.auth.uid` for authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (create) - Authenticated user creates their own profile if the userId matches their auth.uid.
     * @allow (get, update, delete) - Authenticated user can read, update, or delete their own profile.
     * @deny (create) - If userId does not match the authenticated user's uid.
     * @deny (list) - Listing all users is not permitted.
     * @deny (update, delete) - If the user tries to update or delete someone else's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to avatar settings for a specific user.
     * @path /users/{userId}/avatarSettings/{avatarSettingId}
     * @allow (create) - Authenticated user creates avatar settings under their own user ID, userId field matches path.
     * @allow (get, update, delete) - Authenticated user can read, update, or delete their own avatar settings.
     * @deny (create) - If userId does not match the authenticated user's uid.
     * @deny (list) - Listing avatar settings for other users is not permitted.
     * @deny (update, delete) - If the user tries to update or delete someone else's avatar settings.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/avatarSettings/{avatarSettingId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
       function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to conversations for a specific user.
     * @path /users/{userId}/conversations/{conversationId}
     * @allow (create) - Authenticated user creates conversations under their own user ID, userId field matches path.
     * @allow (get, update, delete) - Authenticated user can read, update, or delete their own conversations.
     * @deny (create) - If userId does not match the authenticated user's uid.
     * @deny (list) - Listing conversations for other users is not permitted.
     * @deny (update, delete) - If the user tries to update or delete someone else's conversations.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId}/conversations/{conversationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
       function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}
/**
 * @fileoverview Firestore Security Rules for AvatarSpeak.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model.  Each user can only
 * access their own data stored under their specific user ID.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.
 * - /users/{userId}/avatarSettings/{avatarSettingId}: Stores avatar settings.
 * - /users/{userId}/conversations/{conversationId}: Stores conversation data.
 *
 * Key Security Decisions:
 * - All data is private and accessible only to the owning user.
 * - No user listing is allowed for privacy.
 * - Authorization is based on `request.auth.uid` and path-based ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.  Only the authenticated user can read/write their own profile.
     * @path /users/{userId}
     * @allow (get, update, delete) User with matching {userId} can read/write.
     * @allow (create) User can create their own profile if the userId matches their auth.uid.
     * @deny (get, update, delete) User tries to access another user's profile.
     * @deny (create) User tries to create a profile with an ID that doesn't match their auth.uid.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to avatar settings for a user. Path-based ownership ensures only the user can access their own settings.
     * @path /users/{userId}/avatarSettings/{avatarSettingId}
     * @allow (get, update, delete) User with matching {userId} can read/write their avatar settings.
     * @allow (create) User can create avatar settings under their own userId.
     * @deny (get, update, delete) User tries to access another user's avatar settings.
     * @deny (create) User tries to create avatar settings under another user's userId.
     * @principle Enforces document ownership for all operations via path-based matching.
     */
    match /users/{userId}/avatarSettings/{avatarSettingId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to conversations for a user. Path-based ownership ensures only the user can access their own conversations.
     * @path /users/{userId}/conversations/{conversationId}
     * @allow (get, update, delete) User with matching {userId} can read/write their conversations.
     * @allow (create) User can create conversations under their own userId.
     * @deny (get, update, delete) User tries to access another user's conversations.
     * @deny (create) User tries to create conversations under another user's userId.
     * @principle Enforces document ownership for all operations via path-based matching.
     */
    match /users/{userId}/conversations/{conversationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}
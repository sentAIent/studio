/**
 * @fileoverview Firestore Security Rules for AvatarSpeak.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Users can only
 * access their own data, based on their authenticated `uid`.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information.  `userId` must match the authenticated user's `uid`.
 * - /users/{userId}/avatarSettings/{avatarSettingId}: Stores avatar settings. `userId` must match the authenticated user's `uid`.
 * - /users/{userId}/conversations/{conversationId}: Stores conversation history. `userId` must match the authenticated user's `uid`.
 *
 * Key Security Decisions:
 * - User listing is disallowed to protect user privacy.
 * - All write operations are validated against the authenticated user's `uid` to prevent unauthorized data modification.
 *
 * Denormalization for Authorization:
 * - The data model uses path-based ownership.  There is no need for additional denormalization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile access.
     * @path /users/{userId}
     * @allow (create) Authenticated user creates their own profile with matching userId.
     * @allow (get, update, delete) Authenticated user reads/writes their own profile with matching userId.
     * @deny (create, get, update, delete) Any operation where the userId does not match the authenticated user's uid.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages avatar settings for a user.
     * @path /users/{userId}/avatarSettings/{avatarSettingId}
     * @allow (create, get, list, update, delete) Authenticated user manages their own avatar settings.
     * @deny Any operation where the userId does not match the authenticated user's uid.
     * @principle Restricts access to a user's own avatar settings.
     */
    match /users/{userId}/avatarSettings/{avatarSettingId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
       function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages conversations for a user.
     * @path /users/{userId}/conversations/{conversationId}
     * @allow (create, get, list, update, delete) Authenticated user manages their own conversations.
     * @deny Any operation where the userId does not match the authenticated user's uid.
     * @principle Restricts access to a user's own conversations.
     */
    match /users/{userId}/conversations/{conversationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
       function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}
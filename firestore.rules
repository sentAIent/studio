/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model, where each user can only access their own data.
 *
 * Data Structure:
 * All data is nested under /users/{userId}, ensuring clear ownership. User profiles, avatar settings, and conversations are all stored as subcollections under the user's document.
 *
 * Key Security Decisions:
 * - User listing is disallowed to protect user privacy.
 * - All write operations are restricted to the authenticated user, based on their UID.
 *
 * Denormalization for Authorization:
 * - The data model uses path-based authorization, so data denormalization is not required because ownership is implicitly determined by the document path.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (create) - If the user is creating their own profile (userId matches auth.uid).
     * @allow (get, update, delete) - If the user is accessing their own profile (userId matches auth.uid) and the document exists.
     * @deny (create) - If the user tries to create a profile with an ID that doesn't match their auth.uid.
     * @deny (get, update, delete) - If the user tries to access someone else's profile (userId doesn't match auth.uid), or if the document doesn't exist during update or delete.
     * @principle Enforces document ownership for all operations on user profiles.
     */
    match /users/{userId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the authenticated user is the owner of the document
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if the authenticated user is the owner of the EXISTING document
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to avatar settings for a user.
     * @path /users/{userId}/avatarSettings/{avatarSettingId}
     * @allow (create) - If the user is creating avatar settings under their own profile path.
     * @allow (get, update, delete) - If the user is accessing avatar settings under their own profile path and the document exists.
     * @deny (create) - If the user attempts to create avatar settings under someone else's profile.
     * @deny (get, update, delete) - If the user attempts to access avatar settings under someone else's profile or if the document doesn't exist during update or delete.
     * @principle Restricts access to a user's own avatar settings based on path-based ownership.
     */
    match /users/{userId}/avatarSettings/{avatarSettingId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the authenticated user is the owner of the document
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if the authenticated user is the owner of the EXISTING document
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to conversations for a user.
     * @path /users/{userId}/conversations/{conversationId}
     * @allow (create) - If the user is creating a conversation under their own profile path.
     * @allow (get, update, delete) - If the user is accessing a conversation under their own profile path and the document exists.
     * @deny (create) - If the user attempts to create a conversation under someone else's profile.
     * @deny (get, update, delete) - If the user attempts to access a conversation under someone else's profile, or if the document doesn't exist during update or delete.
     * @principle Restricts access to a user's own conversations based on path-based ownership.
     */
    match /users/{userId}/conversations/{conversationId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the authenticated user is the owner of the document
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if the authenticated user is the owner of the EXISTING document
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}